{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "uv: run active file",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "${fileBasename}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "uvicorn: run server",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "uvicorn",
                "src.server:app",
                "--reload",
                "--port",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$python"
            ]
        },
        
    ]
}